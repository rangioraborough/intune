<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nz.co.myers.macagent.report</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/MacAgent.app/Contents/MacOS/macagent</string>
        <string>report</string>
    </array>
    <!-- Every 10 minutes: send status to the MacAgent Console (if Console is configured) and pick up
         its signed requests. Does nothing when no console is set. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>StandardOutPath</key>
    <string>/Library/Logs/MacAgent/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/MacAgent/launchd.log</string>
</dict>
</plist>
