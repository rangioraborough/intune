<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nz.co.myers.macagent.menu</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/MacAgent/MacAgent Menu.app/Contents/MacOS/MacAgentMenu</string>
    </array>
    <!-- Menu bar icon for every user, restarted if it quits or crashes. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
