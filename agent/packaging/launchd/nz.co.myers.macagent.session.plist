<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>nz.co.myers.macagent.session</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/MacAgent.app/Contents/MacOS/macagent</string>
        <string>run</string>
        <string>--scope</string>
        <string>session</string>
    </array>
    <!-- Every login, for every user, inside their GUI session, and every 4 hours. The daemon also
         kickstarts it after any device run that changed something (e.g. new apps for the Dock).
         (WatchPaths on /Applications doesn't fire on macOS 27, so it isn't relied on.) -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>14400</integer>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ThrottleInterval</key>
    <integer>60</integer>
</dict>
</plist>
